# Server-side FastAPI URL used by API clients and auth BFF routes.
API_BASE_URL=http://localhost:8000

# Development mode shows the archived UI fixtures for stable visual review.
# Set false to use real backend content while developing.
AIGC_DEMO_MODE=true

# Public canonical site origin for metadata generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public browser OAuth client ID (not a client secret).
# Docker: pass as a build argument before next build; runtime-only values do not work.
# Register the production HTTPS domain as an authorized JavaScript origin in Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional HTML verification values from the search engine consoles (no markup).
GOOGLE_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=
